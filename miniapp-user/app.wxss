/** 全局样式 **/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: linear-gradient(135deg, #ff6b35, #ff8f5e);
  color: #fff;
  font-size: 16px;
  border-radius: 22px;
  text-align: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  width: 100%;
  height: 44px;
  line-height: 44px;
  background: #fff;
  color: #ff6b35;
  font-size: 16px;
  border-radius: 22px;
  text-align: center;
  border: 1rpx solid #ff6b35;
}

/* 卡片容器 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background: #fff3ed;
  color: #ff6b35;
}

.tag-success {
  background: #e8f8e8;
  color: #52c41a;
}

.tag-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-default {
  background: #f5f5f5;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-container image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

/* 表单输入 */
.input-group {
  background: #fff;
  padding: 0 30rpx;
}

.input-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
}

.input-item:last-child {
  border-bottom: none;
}

.input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-field::placeholder {
  color: #ccc;
}

/* 安全底部间距（适配全面屏） */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
}

/* ====== 数量加减组件 ====== */
.qty-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #ff6b35;
  border-radius: 28rpx;
  padding: 2rpx;
}
.qty-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}
.qty-btn.minus {
  background: #fff;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
}
.qty-num {
  font-size: 28rpx;
  min-width: 50rpx;
  text-align: center;
  font-weight: bold;
  color: #333;
}
