.shop-card { display: flex; background: #fff; margin: 12rpx 20rpx; padding: 20rpx; border-radius: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.shop-logo { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; background: #f0f0f0; }
.shop-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.shop-name { font-size: 30rpx; font-weight: bold; margin-bottom: 8rpx; }
.shop-meta { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.rating { margin-right: 16rpx; }
.shop-tags { display: flex; gap: 8rpx; }
