<view class="page"><view class="input-group">
  <view class="input-item"><text class="input-label">联系人</text><input class="input-field" placeholder="收货人姓名" bindinput="onInput" data-field="contactName"/></view>
  <view class="input-item"><text class="input-label">手机号</text><input class="input-field" placeholder="收货人手机号" type="number" maxlength="11" bindinput="onInput" data-field="contactPhone"/></view>
  <view class="input-item"><text class="input-label">省份</text><input class="input-field" placeholder="省份" bindinput="onInput" data-field="province"/></view>
  <view class="input-item"><text class="input-label">城市</text><input class="input-field" placeholder="城市" bindinput="onInput" data-field="city"/></view>
  <view class="input-item"><text class="input-label">区域</text><input class="input-field" placeholder="区/县" bindinput="onInput" data-field="district"/></view>
  <view class="input-item"><text class="input-label">详细地址</text><input class="input-field" placeholder="街道、门牌号等" bindinput="onInput" data-field="detail"/></view>
</view>
<view style="padding:40rpx 30rpx">
  <button class="btn-primary" bindtap="save" loading="{{loading}}" disabled="{{loading}}">保存地址</button>
</view></view>
