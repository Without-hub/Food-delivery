<view class="page">
  <!-- 进度条 -->
  <view class="card">
    <view class="steps">
      <view class="step {{index<=currentStep?'active':''}}" wx:for="{{steps}}" wx:key="*this">
        <view class="step-dot"></view>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 骑手信息 -->
  <view class="card rider-card">
    <view class="rider-info">
      <view class="rider-avatar">👨‍🦱</view>
      <view class="rider-detail">
        <text class="rider-name">{{rider.name}}</text>
        <text class="rider-status">已接单，正在赶往商家</text>
      </view>
    </view>
    <view class="call-btn" bindtap="callRider">📞 联系骑手</view>
  </view>

  <!-- 模拟地图 -->
  <view class="card map-placeholder">🗺️ 地图加载中...</view>

  <!-- 订单信息 -->
  <view class="card" wx:if="{{order}}">
    <text style="font-size:28rpx;font-weight:bold;display:block;margin-bottom:12rpx">订单信息</text>
    <view class="info-row"><text>订单编号</text><text>{{order.orderNo}}</text></view>
    <view class="info-row"><text>下单时间</text><text>{{formatTime(order.createTime)}}</text></view>
    <view class="info-row"><text>收货地址</text><text>{{order.addressDetail || ''}}</text></view>
  </view>
</view>
