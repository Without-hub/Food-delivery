<view class="login-container">
  <view class="login-header">
    <image class="logo" src="../../images/tab-home-active.png"></image>
    <text class="title">外卖点餐</text>
    <text class="subtitle">欢迎回来</text>
  </view>

  <view class="form">
    <view class="input-group">
      <view class="input-item">
        <input class="input-field" placeholder="请输入用户名" value="{{username}}" bindinput="onInputUsername" />
      </view>
      <view class="input-item">
        <input class="input-field" placeholder="请输入密码" type="password" value="{{password}}" bindinput="onInputPassword" />
      </view>
    </view>

    <button class="btn-primary" bindtap="handleLogin" loading="{{loading}}" disabled="{{loading}}">登录</button>

    <view class="register-link">
      <text>还没有账号？</text>
      <text class="link" bindtap="goRegister">立即注册</text>
    </view>
  </view>
</view>
