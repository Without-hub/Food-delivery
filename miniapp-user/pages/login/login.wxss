.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #ff6b35 0%, #ff8f5e 40%, #fff 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 50rpx;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}
.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}
.form {
  width: 85%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.register-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}
.link {
  color: #ff6b35;
  margin-left: 8rpx;
}
