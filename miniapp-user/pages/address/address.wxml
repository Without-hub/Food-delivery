<view class="page">
  <view class="address-item" wx:for="{{addressList}}" wx:key="id">
    <view class="addr-info">
      <text class="addr-name">{{item.contactName}} {{item.contactPhone}}</text>
      <text class="addr-detail">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
    </view>
    <view class="addr-actions">
      <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
      <text wx:else class="set-default" data-id="{{item.id}}" bindtap="setDefault">设为默认</text>
      <text class="delete-addr" data-id="{{item.id}}" bindtap="deleteAddr">删除</text>
    </view>
  </view>
  <view class="add-btn-area">
    <button class="btn-primary" bindtap="addAddress">+ 新增地址</button>
  </view>
</view>
