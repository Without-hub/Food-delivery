<view class="page"><view class="input-group">
  <view class="input-item"><text class="input-label">用户名</text><input class="input-field" placeholder="请输入用户名" bindinput="onInput" data-field="username"/></view>
  <view class="input-item"><text class="input-label">手机号</text><input class="input-field" placeholder="请输入手机号" type="number" maxlength="11" bindinput="onInput" data-field="phone"/></view>
  <view class="input-item"><text class="input-label">密码</text><input class="input-field" placeholder="密码至少6位" type="password" bindinput="onInput" data-field="password"/></view>
</view>
<view style="padding:40rpx 30rpx">
  <button class="btn-primary" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">注册</button>
  <view style="text-align:center;margin-top:20rpx;font-size:26rpx;color:#999">已有账号？<text style="color:#ff6b35" bindtap="goBack">返回登录</text></view>
</view></view>
