<wxs src="../../utils/format.wxs" module="fmt" /><scroll-view class="page" scroll-y>
  <!-- 收货地址 -->
  <view class="card address-card" bindtap="addAddress" wx:if="{{!selectedAddr}}">
    <text style="color:#999">请添加收货地址</text>
  </view>
  <view class="card address-card" bindtap="selectAddress" data-id="{{selectedAddr.id}}" wx:else>
    <text class="addr-name">{{selectedAddr.contactName}}<text class="addr-phone"> {{selectedAddr.contactPhone}}</text></text>
    <text class="addr-detail">{{selectedAddr.province}}{{selectedAddr.city}}{{selectedAddr.district}} {{selectedAddr.detail}}</text>
  </view>
  <!-- 地址列表选择 -->
  <view wx:if="{{addressList.length>1}}" class="card">
    <text style="font-size:26rpx;font-weight:bold;margin-bottom:12rpx;display:block">其他地址</text>
    <view class="addr-option {{selectedAddrId===item.id?'active':''}}" wx:for="{{addressList}}" wx:key="id" data-id="{{item.id}}" bindtap="selectAddress">
      <text>{{item.contactName}} {{item.contactPhone}}</text>
      <text style="font-size:24rpx;color:#999">{{item.province}}{{item.city}}{{item.district}} {{item.detail}}</text>
    </view>
  </view>
  <view class="card" style="text-align:center;color:#ff6b35;font-size:26rpx" bindtap="addAddress">+ 新增收货地址</view>

  <!-- 商品清单 -->
  <view class="card">
    <text style="font-size:28rpx;font-weight:bold;display:block;margin-bottom:12rpx">商品清单</text>
    <view class="order-item" wx:for="{{cartItems}}" wx:key="id">
      <text class="oi-name">{{item.dishName}}</text>
      <text class="oi-qty">×{{item.quantity}}</text>
      <text class="oi-price">¥{{fmt.price(item.subtotal || item.price*item.quantity)}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="card">
    <textarea placeholder="给商家留言（选填）" bindinput="onRemarkInput" style="width:100%;font-size:26rpx;min-height:80rpx"></textarea>
  </view>

  <!-- 价格明细 -->
  <view class="card">
    <view class="price-row"><text>商品金额</text><text>¥{{fmt.price(totalPrice)}}</text></view>
    <view class="price-row"><text>配送费</text><text>¥{{fmt.price(deliveryFee)}}</text></view>
    <view class="price-row total"><text>实付金额</text><text>¥{{fmt.price(totalPrice + deliveryFee)}}</text></view>
  </view>
</scroll-view>
<view class="submit-bar">
  <text class="submit-total">实付：<text style="color:#ff6b35;font-size:36rpx">¥{{fmt.price(totalPrice + deliveryFee)}}</text></text>
  <view class="submit-btn" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting}}">提交订单</view>
</view>
