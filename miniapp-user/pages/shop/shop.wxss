.page { height: 100vh; padding-bottom: 100rpx; }
.shop-header { display: flex; padding: 24rpx; background: #fff; margin-bottom: 2rpx; }
.shop-logo { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.shop-detail { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.shop-name { font-size: 32rpx; font-weight: bold; }
.shop-rating { font-size: 24rpx; color: #999; }
.shop-desc { font-size: 24rpx; color: #999; }
.shop-fee { font-size: 24rpx; color: #ff6b35; }
.category-tabs { display: flex; background: #fff; white-space: nowrap; padding: 16rpx 0; }
.tab-item { display: inline-block; padding: 8rpx 28rpx; font-size: 26rpx; color: #666; margin: 0 8rpx; border-radius: 24rpx; }
.tab-item.active { background: #fff3ed; color: #ff6b35; font-weight: bold; }
.dish-list { padding: 16rpx 20rpx; }
.dish-item { display: flex; background: #fff; padding: 20rpx; border-radius: 12rpx; margin-bottom: 12rpx; }
.dish-img { width: 140rpx; height: 140rpx; border-radius: 8rpx; margin-right: 16rpx; }
.dish-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.dish-name { font-size: 28rpx; font-weight: bold; }
.dish-sales { font-size: 22rpx; color: #999; }
.dish-price-row { display: flex; align-items: center; gap: 8rpx; }
.dish-price { font-size: 32rpx; color: #ff6b35; font-weight: bold; }
.dish-original { font-size: 24rpx; color: #ccc; text-decoration: line-through; }
.add-btn { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; background: #ff6b35; color: #fff; border-radius: 50%; font-size: 32rpx; margin-left: auto; }
.cart-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: #333; padding: 0 20rpx; height: 96rpx; }
.cart-info { flex: 1; display: flex; align-items: center; position: relative; }
.cart-icon { font-size: 44rpx; margin-right: 12rpx; }
.cart-badge { position: absolute; left: 28rpx; top: -8rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; background: #ff3b30; color: #fff; font-size: 20rpx; border-radius: 16rpx; padding: 0 4rpx; }
.cart-total { color: #fff; font-size: 30rpx; font-weight: bold; }
.cart-empty { color: #999; font-size: 26rpx; }
.cart-submit { width: 180rpx; height: 72rpx; line-height: 72rpx; text-align: center; background: #ff6b35; color: #fff; border-radius: 36rpx; font-size: 28rpx; }
.cart-submit.disabled { background: #999; }
.cart-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 10; }
.cart-popup { position: fixed; bottom: 96rpx; left: 0; right: 0; max-height: 50vh; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 11; transform: translateY(100%); transition: transform 0.3s; }
.cart-popup.show { transform: translateY(0); }
.popup-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 28rpx; font-weight: bold; }
.popup-list { max-height: 40vh; overflow-y: auto; padding: 0 24rpx; }
.popup-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.popup-name { flex: 1; font-size: 26rpx; }
.popup-price { font-size: 26rpx; color: #ff6b35; margin-right: 20rpx; }
.qty-control { display: flex; align-items: center; gap: 12rpx; border: 2rpx solid #ff6b35; border-radius: 28rpx; padding: 2rpx; }
.qty-btn { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; background: #ff6b35; color: #fff; border-radius: 50%; font-size: 32rpx; font-weight: bold; }
.qty-btn.minus { background: #fff; color: #ff6b35; border: 1rpx solid #ff6b35; }
.qty-num { font-size: 28rpx; min-width: 50rpx; text-align: center; font-weight: bold; color: #333; }
