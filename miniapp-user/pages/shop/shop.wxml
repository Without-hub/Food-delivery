<scroll-view class="page" scroll-y>
  <!-- 店铺头部 -->
  <view class="shop-header">
    <image class="shop-logo" src="../../images/tab-home-active.png"></image>
    <view class="shop-detail">
      <text class="shop-name">{{shop.name}}</text>
      <text class="shop-rating">⭐ {{shop.rating || 4.5}} 月售{{shop.salesVolume || 0}}</text>
      <text class="shop-desc">{{shop.description || ''}}</text>
      <text class="shop-fee">配送费¥{{shop.deliveryFee || 0}} 起送¥{{shop.minPrice || 0}}</text>
    </view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view scroll-x class="category-tabs">
    <view class="tab-item {{activeCategoryId===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryTap">{{item.name}}</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list">
    <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
      <image class="dish-img" src="../../images/tab-home-active.png"></image>
      <view class="dish-info">
        <text class="dish-name">{{item.name}}</text>
        <text class="dish-sales">月售{{item.salesVolume || 0}}</text>
        <view class="dish-price-row">
          <text class="dish-price">¥{{formatPrice(item.price)}}</text>
          <text wx:if="{{item.originalPrice}}" class="dish-original">¥{{formatPrice(item.originalPrice)}}</text>
          <view class="add-btn" data-id="{{item.id}}" bindtap="addToCart">+</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

<!-- 底部购物车栏 -->
<view class="cart-bar">
  <view class="cart-info" bindtap="toggleCart">
    <text class="cart-icon">🛒</text>
    <text wx:if="{{cartCount>0}}" class="cart-badge">{{cartCount}}</text>
    <text class="cart-total" wx:if="{{cartTotal>0}}">¥{{formatPrice(cartTotal)}}</text>
    <text class="cart-empty" wx:else>购物车是空的</text>
  </view>
  <view class="cart-submit {{cartCount>0?'':'disabled'}}" bindtap="goOrder">去结算</view>
</view>

<!-- 购物车弹出层 -->
<view class="cart-overlay" wx:if="{{showCartPopup}}" bindtap="toggleCart"></view>
<view class="cart-popup {{showCartPopup?'show':''}}">
  <view class="popup-header">已选商品 <text style="color:#999;font-size:24rpx" bindtap="toggleCart">关闭</text></view>
  <view class="popup-list">
    <view class="popup-item" wx:for="{{cartItems}}" wx:key="id">
      <text class="popup-name">{{item.dishName}}</text>
      <text class="popup-price">¥{{formatPrice(item.price)}}</text>
      <view class="qty-control">
        <text class="qty-btn" data-id="{{item.id}}" data-delta="{{-1}}" bindtap="updateQty">−</text>
        <text class="qty-num">{{item.quantity}}</text>
        <text class="qty-btn" data-id="{{item.id}}" data-delta="{{1}}" bindtap="updateQty">+</text>
      </view>
    </view>
  </view>
</view>
