<view class="page">
  <!-- 未登录 -->
  <view class="login-prompt" wx:if="{{!isLogin}}" bindtap="goLogin">
    <view class="avatar-placeholder">👤</view>
    <text class="login-text">点击登录</text>
    <text class="login-sub">登录后享受完整功能</text>
  </view>

  <!-- 已登录 -->
  <view class="user-header" wx:else>
    <view class="avatar">👤</view>
    <view class="user-meta">
      <text class="user-name">{{userInfo && userInfo.nickname || userInfo && userInfo.username || '用户'}}</text>
      <text class="user-phone">{{userInfo && userInfo.phone || ''}}</text>
    </view>
  </view>

  <view class="menu-group card">
    <view class="menu-item" bindtap="goOrders"><text>📋 我的订单</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goAddress"><text>📍 收货地址</text><text class="arrow">›</text></view>
  </view>

  <view class="menu-group card" wx:if="{{isLogin}}">
    <view class="menu-item" bindtap="logout"><text style="color:#ff3b30">退出登录</text></view>
  </view>
</view>
