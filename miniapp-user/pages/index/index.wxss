.page { height: 100vh; }
.search-bar { padding: 16rpx 20rpx; background: #fff; }
.search-input { height: 72rpx; background: #f5f5f5; border-radius: 36rpx; padding: 0 30rpx; font-size: 28rpx; }
.banner { height: 320rpx; margin: 16rpx 20rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; background: #ff6b35; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 36rpx; }
.categories { display: flex; white-space: nowrap; padding: 16rpx 0; background: #fff; margin: 0 20rpx 16rpx; border-radius: 12rpx; }
.category-item { display: inline-flex; flex-direction: column; align-items: center; padding: 0 20rpx; min-width: 120rpx; }
.category-icon { font-size: 44rpx; margin-bottom: 8rpx; }
.category-name { font-size: 24rpx; color: #666; }
.category-item.active .category-name { color: #ff6b35; font-weight: bold; }
.shop-list { padding: 0 0 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; padding: 16rpx 24rpx; }
.cart-float { position: fixed; right: 30rpx; bottom: 130rpx; width: 100rpx; height: 100rpx; background: #ff6b35; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 4rpx 16rpx rgba(255,107,53,0.4); }
.cart-icon { font-size: 44rpx; }
.cart-badge { position: absolute; top: -4rpx; right: -4rpx; min-width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; background: #ff3b30; color: #fff; font-size: 22rpx; border-radius: 18rpx; padding: 0 6rpx; }
