.tabs { display: flex; background: #fff; white-space: nowrap; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.tab-item { display: inline-block; padding: 8rpx 24rpx; font-size: 26rpx; color: #666; margin: 0 4rpx; }
.tab-item.active { color: #ff6b35; font-weight: bold; border-bottom: 4rpx solid #ff6b35; }
.order-card { padding: 20rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.order-shop { font-size: 28rpx; font-weight: bold; }
.order-body { margin-bottom: 12rpx; }
.order-items { display: flex; gap: 8rpx; }
.order-img { width: 80rpx; height: 80rpx; border-radius: 6rpx; background: #f0f0f0; }
.order-footer { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #999; }
.order-total { font-size: 28rpx; color: #333; font-weight: bold; }
.order-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f0f0f0; }
.action-btn { padding: 8rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; }
.action-btn.cancel { border: 1rpx solid #ddd; color: #666; }
.action-btn.primary { background: #ff6b35; color: #fff; }
