<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fooddelivery.mapper.ReviewMapper">
    <insert id="insert">
        INSERT INTO review(user_id,order_id,dish_id,rating,content)
        VALUES(#{userId},#{orderId},#{dishId},#{rating},#{content})
    </insert>
    <select id="selectById" resultType="com.example.fooddelivery.entity.Review">
        SELECT * FROM review WHERE id=#{id}
    </select>
    <delete id="deleteById">
        DELETE FROM review WHERE id=#{id}
    </delete>
    <select id="selectByDishId" resultType="com.example.fooddelivery.entity.Review">
        SELECT * FROM review WHERE dish_id=#{dishId}
    </select>
    <select id="selectByUserId" resultType="com.example.fooddelivery.entity.Review">
        SELECT * FROM review WHERE user_id=#{userId}
    </select>
    <select id="selectByUserAndOrder" resultType="com.example.fooddelivery.entity.Review">
        SELECT * FROM review WHERE user_id=#{userId} AND order_id=#{orderId}
    </select>
    <select id="selectAvgRatingByDishId" resultType="java.lang.Double">
        SELECT IFNULL(AVG(rating), 0) FROM review WHERE dish_id=#{dishId}
    </select>
    <select id="selectReviewedOrderIds" resultType="java.lang.Long">
        SELECT order_id FROM review
        WHERE user_id = #{userId} AND order_id IN
        <foreach collection="orderIds" item="oid" open="(" separator="," close=")">
            #{oid}
        </foreach>
    </select>

    <resultMap id="adminReviewMap" type="com.example.fooddelivery.dto.AdminReviewVO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="userName" property="userName"/>
        <result column="order_id" property="orderId"/>
        <result column="shopId" property="shopId"/>
        <result column="shopName" property="shopName"/>
        <result column="dish_id" property="dishId"/>
        <result column="dishName" property="dishName"/>
        <result column="rating" property="rating"/>
        <result column="content" property="content"/>
        <result column="images" property="images"/>
        <result column="reply" property="replyContent"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAdminReviews" resultMap="adminReviewMap">
        SELECT r.*, u.username AS userName, d.name AS dishName,
               d.shop_id AS shopId, s.name AS shopName
        FROM review r
        LEFT JOIN user u ON r.user_id = u.id
        LEFT JOIN dish d ON r.dish_id = d.id
        LEFT JOIN shop s ON d.shop_id = s.id
        ORDER BY r.create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countAdminReviews" resultType="int">
        SELECT COUNT(*) FROM review r
    </select>

    <update id="updateReply">
        UPDATE review SET reply = #{reply} WHERE id = #{id}
    </update>
</mapper>