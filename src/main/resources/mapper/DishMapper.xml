<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fooddelivery.mapper.DishMapper">

    <resultMap id="dishMap" type="com.example.fooddelivery.entity.Dish">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="image" property="image"/>
        <result column="description" property="description"/>
        <result column="price" property="price"/>
        <result column="original_price" property="originalPrice"/>
        <result column="shop_id" property="shopId"/>
        <result column="category_id" property="categoryId"/>
        <result column="sales_volume" property="salesVolume"/>
        <result column="stock" property="stock"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="dishMap">
        SELECT * FROM dish WHERE id = #{id}
    </select>

    <select id="selectByIds" resultMap="dishMap">
        SELECT * FROM dish WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectByShopId" resultMap="dishMap">
        SELECT * FROM dish WHERE shop_id = #{shopId} AND status = 1
        ORDER BY sales_volume DESC
    </select>

    <select id="selectByCategoryId" resultMap="dishMap">
        SELECT * FROM dish
        WHERE category_id = #{categoryId} AND status = 1
        ORDER BY sales_volume DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="searchByName" resultMap="dishMap">
        SELECT * FROM dish
        WHERE name LIKE CONCAT('%', #{keyword}, '%') AND status = 1
        ORDER BY sales_volume DESC
    </select>

    <select id="selectDishPage" resultMap="dishMap">
        SELECT * FROM dish
        WHERE shop_id = #{shopId} AND status = 1
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY sales_volume DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCategoryByShopId" resultType="com.example.fooddelivery.entity.Category">
        SELECT id, name, shop_id, sort_order, create_time
        FROM category
        WHERE shop_id = #{shopId}
        ORDER BY sort_order ASC
    </select>

    <resultMap id="adminDishResultMap" type="com.example.fooddelivery.dto.AdminDishVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="price" property="price"/>
        <result column="image" property="image"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="shop_id" property="shopId"/>
        <result column="shop_name" property="shopName"/>
        <result column="sales_volume" property="salesCount"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAdminDishes" resultMap="adminDishResultMap">
        SELECT d.*, c.name AS category_name, s.name AS shop_name
        FROM dish d
        LEFT JOIN category c ON d.category_id = c.id
        LEFT JOIN shop s ON d.shop_id = s.id
        <where>
            <if test="name != null and name != ''">AND d.name LIKE CONCAT('%', #{name}, '%')</if>
            <if test="status != null">AND d.status = #{status}</if>
        </where>
        ORDER BY d.create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countAdminDishes" resultType="int">
        SELECT COUNT(*) FROM dish d
        <where>
            <if test="name != null and name != ''">AND d.name LIKE CONCAT('%', #{name}, '%')</if>
            <if test="status != null">AND d.status = #{status}</if>
        </where>
    </select>

    <insert id="insertDish" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dish (name, description, price, image, shop_id, category_id, sales_volume, status, create_time, update_time)
        VALUES (#{name}, #{description}, #{price}, #{image}, #{shopId}, #{categoryId}, 0, 1, NOW(), NOW())
    </insert>

    <update id="updateDish">
        UPDATE dish
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="price != null">price = #{price},</if>
            <if test="image != null">image = #{image},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteDish">
        DELETE FROM dish WHERE id = #{id}
    </delete>
</mapper>
